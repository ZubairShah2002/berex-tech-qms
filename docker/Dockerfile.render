# Combined Dockerfile for PaaS deployment (Render, Railway, Fly.io)
# Builds both the React frontend and .NET API into a single container
# served through the .NET Kestrel server with static file middleware.

# ---- Stage 1: Build React frontend ----
FROM node:22-alpine AS frontend-build
WORKDIR /app
COPY src/BerexQms.Web/package*.json ./
RUN npm ci
COPY src/BerexQms.Web/ .
RUN npm run build

# ---- Stage 2: Build .NET API ----
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS api-build
WORKDIR /src

COPY BerexQms.sln ./
COPY src/BerexQms.SharedKernel/BerexQms.SharedKernel.csproj src/BerexQms.SharedKernel/
COPY src/BerexQms.Domain/BerexQms.Domain.csproj src/BerexQms.Domain/
COPY src/BerexQms.Application/BerexQms.Application.csproj src/BerexQms.Application/
COPY src/BerexQms.Infrastructure/BerexQms.Infrastructure.csproj src/BerexQms.Infrastructure/
COPY src/BerexQms.Api/BerexQms.Api.csproj src/BerexQms.Api/

RUN dotnet restore src/BerexQms.Api/BerexQms.Api.csproj

COPY src/ src/
WORKDIR /src/src/BerexQms.Api
RUN dotnet publish -c Release -o /app/publish --no-restore

# ---- Stage 3: Runtime ----
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

COPY --from=api-build /app/publish .
COPY --from=frontend-build /app/dist ./wwwroot
COPY docker/init-db.sql /app/init-db.sql

# Render uses PORT env var; default to 10000
ENV ASPNETCORE_URLS=http://+:${PORT:-10000}
EXPOSE 10000

ENTRYPOINT ["dotnet", "BerexQms.Api.dll"]
