# Copy to .env (never commit real values).

# PostgreSQL connection string (PostgreSQL 13 or newer).
DATABASE_URL=postgres://spec:change-me@localhost:5432/spec_lookup
# Schema that holds all tables. Lets the app share one database with Berex Tech QMS.
DB_SCHEMA=spec_lookup
# "false" for local/internal connections, "true" to require verified TLS,
# "no-verify" for providers that use self-signed certificates.
DATABASE_SSL=false

# First administrator, created only when the users table is empty.
# If ADMIN_PASSWORD is empty, a one-time password is generated and printed in the log.
ADMIN_USER_ID=admin
ADMIN_PASSWORD=

PORT=8080
NODE_ENV=production
# Session length in hours (extended while the user is active).
SESSION_TTL_HOURS=12
# Secure cookies need HTTPS. Defaults to true when NODE_ENV=production.
# Set false only when testing over plain http on a local network.
COOKIE_SECURE=true

# Upload limits in MB.
MAX_FILE_MB=10
MAX_IMPORT_MB=10
LOG_LEVEL=info
